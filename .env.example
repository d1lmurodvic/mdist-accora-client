# Base path of the Accora API as seen by the browser. The default uses the
# Vite dev proxy (same origin). For a separately hosted API, set the full URL,
# e.g. https://api.example.com/api/v1, and allow this origin in the backend's
# CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api/v1

# Backend address the dev proxy forwards /api to (development only).
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
